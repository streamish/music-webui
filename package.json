    "@qantesm/nanostorage": "^1.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@types/pdfjs-dist": "^2.10.377",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "framer-motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.296",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-data-table-component": "^8.8.2",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-pdf": "^10.4.1",
    "react-responsive": "^10.0.1",
    "react-router": "^7.14.1",
    "react-router-dom": "^7.15.1",
    "react-select": "^5.10.2",
    "react-tabs": "^6.1.1",
    "react-timezone-select": "^3.3.3",
    "react-toastify": "^11.1.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "description": "Streamish Music Web UI; a responsive and user-friendly browser interface for Streamish Music Server.",
  "devDependencies": {
    "@nuxt/kit": "^4.4.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-check-file": "^2.6.2",
    "eslint-plugin-folders": "^1.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "lucide-react": "^1.20.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.1",
    "typescript": "~5.8",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build:dev": "tsc -b && vite build --watch",
    "build:prod": "tsc -b && vite build --mode production",
    "build:test": "tsc --noEmit -p tsconfig.app.json && npx dotenv -e .env.test -- vite build --mode test",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "start:dev": "vite --host localhost --port 8000 -- --inspect",
    "start:prod": "http-server dist --host localhost --port 8000",
    "start:test": "vite preview --mode test --host localhost --port 8100",
    "openapi:generate": "npx openapi-typescript http://localhost:7100/swagger.json -o ./src/types/api-schema.ts --enum --export-type",
    "test": "npx dotenv -e .env.test -- npx playwright test",
    "test:ci": "npx dotenv -e .env.test -- npx playwright test --reporter=line --workers=1"
  },
  "name": "music-webui",
  "private": true,
  "type": "module",
  "version": "0.0.6"
}
